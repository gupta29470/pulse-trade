# PulseTrade backend configuration.
# Copy to .env (loaded automatically in debug builds) or export these directly.
# Environment variables always win over this file.

# --- Engine ---------------------------------------------------------------
GENERATOR_SEED=20260917
SYMBOL=BTCUSDT
TRADES_PER_SECOND=10
BOOK_REFRESH_HZ=10
BOOK_LEVELS=100
BOOK_DELTA_WINDOW=15
HISTORY_LIMIT_MAX=500
WARMUP_SPAN=720h
WARMUP_MAX_EVENTS=1000000
VOLATILITY_BURST_RATE=4
RECENT_TRADES_CAPACITY=200

# --- Transport ------------------------------------------------------------
HTTP_ADDR=0.0.0.0:8080
WS_PATH=/ws
WS_READ_LIMIT_BYTES=16384
WS_CLIENT_MSG_PER_SEC=20
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
SHUTDOWN_GRACE=5s

# --- Delivery / tiers -----------------------------------------------------
TIER_FULL_MAX_RTT_MS=150
TIER_FULL_MAX_JITTER_MS=50
TIER_MINIMAL_MIN_RTT_MS=500
TIER_MINIMAL_MIN_JITTER_MS=150
TIER_RATE_FULL_PER_SEC=10
TIER_RATE_DEGRADED_PER_SEC=2
TIER_RATE_MINIMAL_PER_SEC=0.5
TIER_DEGRADE_STREAK=3
TIER_RECOVER_STREAK=5
HEALTH_REPORT_HOLD=5s
HEALTH_REPORT_DEGRADE=10s
HEALTH_WATCHDOG_INTERVAL=250ms
SESSION_OUTBOUND_CAPACITY=256
SESSION_WRITE_TIMEOUT=5s
MAX_SESSION_SUBSCRIPTIONS=8

# --- Metrics --------------------------------------------------------------
METRICS_ENABLED=true
METRICS_DRIVER=sqlite
METRICS_DB_PATH=./data/pulsetrade.db
METRICS_QUEUE_CAPACITY=4096
METRICS_BATCH_SIZE=128
METRICS_FLUSH_INTERVAL=250ms
METRICS_RETENTION_ENABLED=true
METRICS_RETENTION_LATENCY=24h
METRICS_RETENTION_EVENTS=168h
METRICS_RETENTION_SESSIONS=2160h
METRICS_PRUNE_INTERVAL=10m
METRICS_PRUNE_BATCH=5000

# --- Debug / observability ------------------------------------------------
# ENABLE_DEBUG_CONTROLS is ignored (forced off) when DEBUG_BUILD=false.
ENABLE_DEBUG_CONTROLS=true
DEBUG_BUILD=true
LOG_LEVEL=info
